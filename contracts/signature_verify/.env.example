# Casper Signature Service Configuration

# Path to signer's Ed25519 public key (PEM format)
SIGNER_PUBLIC_KEY_PATH=/path/to/signer_keys/public_key.pem

# Path to signer's Ed25519 private key (PEM format)
SIGNER_SECRET_KEY_PATH=/path/to/signer_keys/secret_key.pem

# Optional: Port for Casper signature service
CASPER_PORT=3001

# Casper Network Configuration
CASPER_NODE_URL=http://65.109.222.111:7777/rpc
CASPER_CHAIN_NAME=casper-test

# Contract Hash (after deployment)
SIGNATURE_VERIFY_CONTRACT_HASH=hash-...
