{
  "name": "mogate-rwa-raffle-monorepo",
  "version": "1.0.0",
  "description": "Mogate RWA Raffle Platform - Monorepo",
  "private": true,
  "scripts": {
    "comment:casper": "=== Casper Deployment (matches Solana pattern) ===",
    "casper:1-deploy-moga": "bash scripts/casper/1-deploy-moga-token.sh",
    "casper:2-deploy-collection-1o1": "bash scripts/casper/2-deploy-tixia-1o1-collection.sh",
    "casper:3-deploy-collection-sft": "bash scripts/casper/3-deploy-tixia-sft-collection.sh",
    "casper:4-mint-nft": "bun run scripts/casper/mint-nft.ts",
    "casper:5-validate-burn": "bun run scripts/casper/validate-burn.ts",
    "comment:permit": "=== Permit System (Advanced) ===",
    "casper:build-permit": "cd contracts/authority_mint_permit && RUSTFLAGS='-C target-cpu=mvp' cargo +nightly-2025-02-04 build --release --target wasm32-unknown-unknown -Z build-std=std,panic_abort",
    "casper:deploy-permit": "cd contracts/authority_mint_permit && ./deploy-authority-mint-permit.sh",
    "casper:request-permit": "bun run scripts/casper/request-permit.ts",
    "casper:mint-with-permit": "bun run scripts/casper/mint-with-permit.ts"
  },
  "dependencies": {
    "bs58": "^5.0.0",
    "casper-js-sdk": "2.15.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
