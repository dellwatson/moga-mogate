{
  "name": "mogate-rwa-raffle-monorepo",
  "version": "1.0.0",
  "description": "Mogate RWA Raffle Platform - Monorepo",
  "private": true,
  "scripts": {
    "comment:casper": "=== Casper Scripts ===",
    "casper:build-authority-mint": "cd contracts/+casper_authority_mint && RUSTFLAGS='-C target-cpu=mvp' cargo +nightly-2025-02-04 build --release --target wasm32-unknown-unknown -Z build-std=std,panic_abort",
    "casper:deploy-authority-mint": "cd contracts/+casper_authority_mint && ./deploy-authority-mint.sh",
    "casper:allow-collections": "cd contracts/+casper_authority_mint && ./allow-collections.sh",
    "casper:deploy-collection-1o1": "cd contracts/$moga-collection && ./deploy-tixia-1o1.sh",
    "casper:deploy-collection-sft": "cd contracts/$moga-collection && ./deploy-tixia-sft.sh",
    "casper:mint-nft": "bun run scripts/casper/mint-nft.ts",
    "casper:validate-burn": "bun run scripts/casper/validate-burn.ts",
    "casper:deploy-all": "bun run casper:build-authority-mint && bun run casper:deploy-authority-mint && bun run casper:allow-collections"
  },
  "dependencies": {
    "casper-js-sdk": "^2.15.4",
    "bs58": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
